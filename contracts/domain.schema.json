{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "电子提单控制权交接共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "actors",
    "facts",
    "constraints",
    "per_bill_checks",
    "transfer_rules",
    "visibility_rules",
    "exception_events",
    "audit_requirements"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "per_bill_checks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "transfer_rules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "visibility_rules": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "exception_events": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "string"
      }
    },
    "audit_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
